# Copiar a .env (scripts de base de datos) y a .dev.vars (Worker local). Nunca subir valores reales.
# En local, con docker compose: postgres://rcube:rcube_local@localhost:54329/rcube
DATABASE_URL=
# Cadena aleatoria de al menos 32 caracteres (en producción: secreto de Wrangler)
BETTER_AUTH_SECRET=
# URL pública de la app (local: http://localhost:5173)
PUBLIC_URL=
# Contraseñas de las cuentas de demostración que crea npm run db:seed
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
