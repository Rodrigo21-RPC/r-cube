{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@web/*": ["./src/web/*"]
    }
  },
  "include": ["src/web", "src/shared", "e2e", "playwright.config.ts", "vite.config.ts", "vitest.config.ts", "drizzle.config.ts", "scripts"],
  "exclude": ["scripts/fotos"]
}
